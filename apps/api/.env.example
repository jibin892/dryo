# Dryo API — copy to .env and fill in DATABASE_URL.
PORT=8080

# PostgreSQL 18: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=
DB_MAX_CONNS=10
RUN_MIGRATIONS=true
SEED_ON_MIGRATE=true

# Firebase ID-token verification
FIREBASE_PROJECT_ID=dryo-18227
GOOGLE_APPLICATION_CREDENTIALS=
AUTH_DISABLED=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# OneSignal push (server-sent notifications on actions)
ONESIGNAL_APP_ID=d0b787e4-6ae5-4869-ad83-9086b501040f
# REST API key from OneSignal → Settings → Keys & IDs. Without it, pushes are a no-op.
ONESIGNAL_REST_API_KEY=
